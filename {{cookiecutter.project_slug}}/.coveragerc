[run]
source =
    {{ cookiecutter.package_name }}/

omit =
    */__main__.py
    */tests/*

[report]
show_missing = True
fail_under = 80
exclude_also =
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
    @(abc\.)?abstractmethod
    \.\.\.

[html]
directory = coverage_html_report
